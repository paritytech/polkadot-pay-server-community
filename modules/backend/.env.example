# HTTP listen port.
PORT=8788

# Public origin used to build payment_url and QR asset URLs.
BASE_URL=http://localhost:8788

# Network selector — single source of truth.
# Accepted values: paseo | paseo-next-v2 | previewnet. Defaults to paseo-next-v2.
# The backend derives People-chain / system-chain endpoints from this key via
# modules/backend/src/networks.ts; PEOPLE_RPC_URL is no longer accepted as a
# public selection path.
NETWORK=paseo-next-v2

# Operator account (optional; secret). When set, this single BIP39 mnemonic
# derives the operator account used to fund coin mints via topUp and to
# receive automatic settlement of swept coins. Individual coin secrets —
# not this mnemonic — sign each Coinage.transfer on the People chain, paying
# out to the operator account. Leave empty to disable both top-ups and
# automatic settlement; merchants keep the manual claim-export flow. NEVER
# commit a real mnemonic to this file.
OPERATOR_MNEMONIC=

# People-chain value-transfer authorization key (optional; secret). 32-byte
# ed25519 seed as 0x-prefixed hex (64 hex chars after 0x). The People
# chain's value-transfer-auth pallet blocks every Coinage value-moving call
# (Coinage.transfer, load_recycler_with_coin,
# unload_recycler_into_external_asset) unless the extrinsic's
# AuthorizeValueTransfer signed extension carries a valid ed25519 signature
# from this key over blake2_256(inherited_implication) of the call. This is
# the same authorization key baked into the official Polkadot Android/iOS
# apps (upstream name W3S_AUTH_KEY / W3SCIKeys.w3sAuthKeyHex). Leave empty to
# attempt unauthorized transfers, which the chain rejects with
# System.CallFiltered. NEVER commit a real key to this file.
PAYMENTS_V1_AUTH_KEY=

# PostgreSQL connection string.
DATABASE_URL=postgres://payment_processor:payment_processor_dev_only@localhost:5432/payment_processor

# 32-byte master key as 64 lowercase/uppercase hex chars.
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Required shared secret for self-service account creation (POST /v1/accounts).
# Operators must distribute this only to approved merchants. Empty or missing
# values prevent the backend from starting. Rotate by restarting the service.
SIGNUP_CODE=

# Auto-settlement tuning (settles under the operator account above). Applies
# only when OPERATOR_MNEMONIC is set; leaving OPERATOR_MNEMONIC empty
# disables automatic settlement.
SETTLEMENT_ACCOUNT_PATH=
SETTLEMENT_POLL_MS=20000
# Maximum settlement claim attempts before a payment is marked failed; defaults to 5.
SETTLEMENT_MAX_CLAIM_ATTEMPTS=5

