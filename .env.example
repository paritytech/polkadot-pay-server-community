# Local development stack
POSTGRES_DB=payment_processor
POSTGRES_USER=payment_processor
POSTGRES_PASSWORD=payment_processor_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgres://payment_processor:payment_processor_dev_only@postgres:5432/payment_processor

# Redis for settlement claims
# Claims are processed one at a time to avoid nonce races on the settlement account.
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Backend
PORT=8788
BACKEND_PORT=8788
BASE_URL=http://localhost:8788
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Required shared secret for merchant account creation. Empty or missing values
# prevent the backend from starting; distribute it only to approved merchants.
SIGNUP_CODE=

# Network selector — single source of truth for both backend and dashboard.
# Accepted values: paseo | paseo-next-v2 | previewnet. Defaults to paseo-next-v2.
# The backend derives People-chain/system-chain endpoints from this key; do not
# also set a legacy PEOPLE_RPC_URL — it is no longer a public selection path.
NETWORK=paseo-next-v2

# Operator account (optional; secret).
# When set, this single BIP39 mnemonic derives the operator account used by:
#   * topUp to fund new coin mints, and
#   * auto-settlement to receive swept coins.
# Individual coin secrets — not this mnemonic — sign each Coinage.transfer on
# the People chain, paying out to the operator account (the default sr25519
# account when SETTLEMENT_ACCOUNT_PATH is empty). Leave empty to disable both
# top-ups and automatic settlement; merchants keep the manual "bun run cli
# export-claims" / "mark-claimed" flow for payouts. NEVER put a real mnemonic
# in this template — provide your own locally and keep it out of version
# control.
OPERATOR_MNEMONIC=

# People-chain value-transfer authorization key (optional; secret). 32-byte
# ed25519 seed as 0x-prefixed hex (64 hex chars after 0x). The People chain's
# value-transfer-auth pallet filters every Coinage value-moving call unless the
# extrinsic's AuthorizeValueTransfer signed extension carries a valid ed25519
# signature from this key over blake2_256(inherited_implication) of the call.
# This is the same authorization key the official Polkadot Android/iOS apps
# carry. Leave empty and coin transfers fail with System.CallFiltered. NEVER
# put a real key in this template.
PAYMENTS_V1_AUTH_KEY=
# Auto-settlement tuning (settles under the operator account above). Applies
# only when OPERATOR_MNEMONIC is set.
# Sr25519 derivation path for the operator account. Empty = the mnemonic's
# default account.
SETTLEMENT_ACCOUNT_PATH=
# Poll interval for the settlement worker in milliseconds.
SETTLEMENT_POLL_MS=20000
# Maximum settlement claim attempts before a payment is marked failed; defaults to 5.
SETTLEMENT_MAX_CLAIM_ATTEMPTS=5

# Admin dashboard
# Backend 302-redirects GET /dashboard to DASHBOARD_URL; the UI itself is served
# by the standalone `dashboard` module on DASHBOARD_PORT.
DASHBOARD_PORT=5175
DASHBOARD_URL=http://localhost:5175
# Optional: absolute base URL the UI prepends to /v1 requests when not going
# through the Vite dev proxy. Leave empty to use the same-origin proxy path.
VITE_API_BASE_URL=